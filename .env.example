# =============================================================================
# BaseWeb environment configuration
#
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ENVIRONMENT=production enforces that every "required in production"
# variable below is set - the app refuses to start otherwise (fail-secure).
# =============================================================================

ENVIRONMENT=development

# --- Core / security ---------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
# Bare hostnames only - no "http://"/"https://" scheme, no path. Comma-
# separate multiple (e.g. the apex domain and www.). This is matched
# against the HTTP Host header, which never includes a scheme.
ALLOWED_HOSTS=localhost,127.0.0.1
ENCRYPTION_KEY=change-me-32-byte-urlsafe-base64-fernet-key
ADMIN_URL=x73k29-admin/
# Full URL(s) *with* scheme. May be a single URL or a comma-separated list
# (e.g. an http and https variant during a TLS transition) - the first is
# used for links in emails, all of them become allowed CORS/CSRF origins.
FRONTEND_URL=http://localhost:5173

# Set to False if this deployment is plain HTTP (e.g. testing the
# production Docker stack locally with no TLS certificate). Leave True
# once a real domain + HTTPS-terminating proxy/load balancer is in front.
SECURE_SSL_REDIRECT=True

# --- Database (SQLite used automatically in development) --------------------
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=baseweb
DATABASE_USER=baseweb
DATABASE_PASSWORD=change-me
DATABASE_HOST=db
DATABASE_PORT=5432

# --- Email (console backend used automatically in development) --------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

# --- Storage ------------------------------------------------------------------
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media
EXPORTS_ROOT=/app/exports

# --- Anti-bot: Cloudflare Turnstile (primary) --------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# --- Anti-bot: Google reCAPTCHA (fallback) -----------------------------------
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- GeoIP restrictions -------------------------------------------------------
GEOIP_ENABLED=False
GEOIP_PROVIDER=ip-api
GEOIP_API_KEY=

# --- Trusted reverse proxies --------------------------------------------------
# Exact IPs or CIDR ranges (e.g. the Docker network subnet) allowed to set
# X-Forwarded-For. Never trust this header from anyone else.
TRUSTED_PROXY_IPS=172.16.0.0/12

# =============================================================================
# Frontend (Vite) - baked into the client bundle at BUILD time, never secret.
# =============================================================================
# A SINGLE URL only - unlike FRONTEND_URL above, this is used as-is with no
# parsing on the frontend. A comma-separated value here will silently break
# every request (the frontend falls back to just the first entry and logs a
# console warning if you do this, but don't rely on that - just use one URL).
VITE_API_URL=http://localhost:8000
VITE_TURNSTILE_SITE_KEY=
